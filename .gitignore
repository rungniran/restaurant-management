# ==============================
# Environment / secrets — NEVER commit these
# ==============================
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# JWT secrets, PromptPay keys, service account files, certs
*.pem
*.key
*.crt
*.p12
*credentials*.json
*serviceAccount*.json

# ==============================
# Dependencies
# ==============================
node_modules/
**/node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# ==============================
# Build output
# (frontend apps build straight into backend/public — don't commit generated output)
# ==============================
backend/public/
dist/
dist-ssr/
build/
*.local

# ==============================
# Logs
# ==============================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==============================
# Runtime / uploads / generated data
# ==============================
uploads/
tmp/
temp/
*.pid
*.seed
*.pid.lock

# Generated QR codes / receipts if written to disk
**/generated/
**/qrcodes/
**/receipts/

# ==============================
# Database
# ==============================
*.sqlite
*.sqlite3
dump/
mongo-data/

# ==============================
# Editor / IDE
# ==============================
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ==============================
# OS files
# ==============================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ==============================
# Testing / coverage
# ==============================
coverage/
.nyc_output/

# ==============================
# Misc
# ==============================
*.tsbuildinfo
.cache/
.eslintcache