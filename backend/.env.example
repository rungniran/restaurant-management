PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/qr-food-order
JWT_SECRET=replace-with-your-secret-key
CORS_ORIGIN=http://localhost:5173,http://localhost:5175,http://localhost:4000
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
PROMPTPAY_ID=0812345678

# Shared secret the payment gateway must send in the "X-Webhook-Secret" header
# when calling POST /api/payment/webhook. Leave unset to keep the webhook
# disabled (returns 401) until a real gateway integration is wired up.
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-string
