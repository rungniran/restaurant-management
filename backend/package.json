{
  "name": "qr-food-order-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "src/app.js",
  "scripts": {
    "dev": "nodemon src/app.js",
    "start": "node src/app.js",
    "seed": "node src/seed.js",
    "build:customer": "cd ../frontend/customer && npm install && npm run build",
    "build:staff": "cd ../frontend/staff && npm install && npm run build",
    "build:frontend": "npm run build:customer && npm run build:staff",
    "build": "npm run build:frontend",
    "serve": "npm run build:frontend && npm start"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "google-auth-library": "^11.0.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.0",
    "multer": "^2.2.0",
    "nanoid": "^5.0.7",
    "qrcode": "^1.5.4",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
